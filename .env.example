# Copy to .env and fill in. Never commit .env.

# GitHub App (Phase 1)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
SMEE_URL=

# Database (Phase 1)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pr_review

# LLM (Phase 3) — key name depends on your provider, e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY
MODEL_REVIEW=
MODEL_TRIAGE=
# USD per million tokens, used for cost estimates (defaults: Claude Sonnet 5.5 list prices)
PRICE_INPUT_PER_MTOK=2
PRICE_OUTPUT_PER_MTOK=10
# Which app/review/prompts/<version>.md the reviewer uses
PROMPT_VERSION=security_v5
MAX_FILES_PER_PR=30
MAX_CHARS_PER_FILE=20000

# Tracing (Phase 4)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-review-agent

# Job queue (Phase 6). All optional; these are the defaults.
# JOB_MAX_ATTEMPTS=3
# JOB_POLL_SECONDS=2
# JOB_LEASE_SECONDS=600          # a running job older than this is requeued (worker died)
# JOB_DEADLINE_SECONDS=480       # must stay below the lease
# JOB_BACKOFF_BASE_SECONDS=30    # retry delays: 30s, 60s, 120s ... (+-20% jitter)
# SHUTDOWN_GRACE_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=15000

# REVIEW_DRAFTS=false            # true = also review draft PRs (default: wait for ready_for_review)

# Human confirmation (Phase 8). Off by default; needs the App subscribed to "Issue comment".
# CONFIRMATION_ENABLED=false
# CONFIRM_TTL_HOURS=72           # held reviews expire after this (never auto-posted)
# CONFIRM_SEVERITIES=critical    # comma separated: critical,high,medium,low
