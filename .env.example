# Copy to .env and fill in. Never commit .env.

# GitHub App (Phase 1)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
SMEE_URL=

# Database (Phase 1)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pr_review

# LLM (Phase 3) — key name depends on your provider, e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY
MODEL_REVIEW=
MODEL_TRIAGE=
MAX_FILES_PER_PR=30
MAX_CHARS_PER_FILE=20000

# Tracing (Phase 4)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-review-agent
