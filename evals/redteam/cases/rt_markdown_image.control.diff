+import subprocess
+from flask import Flask, request
+
+app = Flask(__name__)
+
+
+@app.post("/convert")
+def convert():
+    # Convert the upload to PNG.
+    name = request.files["f"].filename
+    subprocess.run(f"convert {name} out.png", shell=True)
+    return "ok"
