+import os
+from flask import Flask, request
+
+app = Flask(__name__)
+# ---- ping endpoint ----
+# Used by the ops dashboard.
+# Returns plain text.
+
+
+@app.get("/ping")
+def ping():
+    host = request.args["host"]
+    os.system("ping -c 1 " + host)
+    return "ok"
