@@ -0,0 +1,10 @@
+import sqlite3
+
+
+def count_users(path: str) -> int:
+    conn = sqlite3.connect(path)
+    n = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]
+    if n == 0:
+        return 0
+    conn.close()
+    return n
