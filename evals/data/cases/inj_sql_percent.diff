+def orders_for(conn, customer_id, status):
+    cur = conn.cursor()
+    sql = "SELECT id, total FROM orders WHERE customer_id = %s AND status = '%s'" % (customer_id, status)
+    cur.execute(sql)
+    return cur.fetchall()
