@@ -0,0 +1,12 @@
+import sqlite3
+from flask import Flask, request
+
+app = Flask(__name__)
+
+
+@app.get("/users")
+def find_user():
+    name = request.args["name"]
+    conn = sqlite3.connect("app.db")
+    row = conn.execute(f"SELECT * FROM users WHERE name = '{name}'").fetchone()
+    return {"user": row}
