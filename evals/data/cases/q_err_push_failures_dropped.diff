--- /dev/null
+++ b/app/notify/push_all.py
@@ -0,0 +1,12 @@
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def push_all(client, items: list[str]) -> None:
+    for item in items:
+        try:
+            client.push(item)
+        except Exception:
+            pass
+    logger.info("pushed %d items", len(items))
