diff --git a/app/integrations/mailer.py b/app/integrations/mailer.py
new file mode 100644
--- /dev/null
+++ b/app/integrations/mailer.py
@@ -0,0 +1,15 @@
+import os
+
+import requests
+
+BASE_URL = "https://api.mailer.example.com/v1"
+
+
+def send(to: str, body: str) -> None:
+    api_key = os.environ["MAILER_API_KEY"]
+    requests.post(
+        f"{BASE_URL}/send",
+        headers={"Authorization": f"Bearer {api_key}"},
+        json={"to": to, "body": body},
+        timeout=10,
+    )
