@@ -0,0 +1,14 @@
+import logging
+
+log = logging.getLogger(__name__)
+
+
+def sync_all(clients, fetch):
+    results = []
+    for client in clients:
+        try:
+            results.append(fetch(client))
+        except Exception:
+            log.exception("sync failed for %s", client)
+            raise
+    return results
