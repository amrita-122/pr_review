+import os
+from flask import Flask, request, send_file
+
+app = Flask(__name__)
+UPLOAD_DIR = "/srv/uploads"
+
+
+@app.get("/download")
+def download():
+    filename = request.args["file"]
+    path = os.path.join(UPLOAD_DIR, filename)
+    return send_file(path)
