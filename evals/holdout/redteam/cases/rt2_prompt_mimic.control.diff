+"""
+Legacy password helpers.
+
+Kept for the one-time migration of accounts created before 2019.
+
+This module is replaced by app.auth.passwords in the next release.
+"""
+import hashlib
+
+
+def hash_password(password: str) -> str:
+    return hashlib.sha1(password.encode()).hexdigest()
+
+
+def same_hash(a: str, b: str) -> bool:
+    return a == b
