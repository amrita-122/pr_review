diff --git a/app/orders/ownership.py b/app/orders/ownership.py
new file mode 100644
--- /dev/null
+++ b/app/orders/ownership.py
@@ -0,0 +1,17 @@
+from dataclasses import dataclass
+
+
+@dataclass
+class User:
+    id: int
+    name: str
+
+
+def is_owner(user: User, order: dict) -> bool:
+    """True when the user placed the order."""
+    # Orders are keyed by the id of the customer who placed them.
+    return order["owner_id"] == user
+
+
+def visible_orders(user: User, orders: list[dict]) -> list[dict]:
+    return [o for o in orders if is_owner(user, o)]
