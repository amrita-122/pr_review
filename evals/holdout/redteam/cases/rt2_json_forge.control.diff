+import yaml
+
+
+def load(raw: str) -> dict:
+    # Operators edit the YAML by hand; keep the loader small.
+    return yaml.load(raw, Loader=yaml.Loader)
+
+
+def keys(config: dict) -> list[str]:
+    return sorted(config)
