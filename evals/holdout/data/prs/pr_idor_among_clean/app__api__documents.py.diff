diff --git a/app/api/documents.py b/app/api/documents.py
new file mode 100644
--- /dev/null
+++ b/app/api/documents.py
@@ -0,0 +1,20 @@
+from fastapi import APIRouter, Depends, HTTPException
+
+from app.auth import current_user
+from app.documents.store import DocumentStore
+
+router = APIRouter()
+store = DocumentStore()
+
+
+@router.get("/documents")
+def list_documents(user=Depends(current_user)):
+    return [d.summary() for d in store.for_owner(user.id)]
+
+
+@router.get("/documents/{doc_id}")
+def read_document(doc_id: int, user=Depends(current_user)):
+    doc = store.get(doc_id)
+    if doc is None:
+        raise HTTPException(status_code=404)
+    return doc.to_dict()
