+from app.documents.store import Document, DocumentStore
+
+
+def test_for_owner_only_returns_that_owners_documents():
+    store = DocumentStore()
+    store.add(Document(id=1, owner_id=10, title="a"))
+    store.add(Document(id=2, owner_id=11, title="b"))
+    assert [d.id for d in store.for_owner(10)] == [1]
