diff --git a/app/auth/reset_password.py b/app/auth/reset_password.py
new file mode 100644
--- /dev/null
+++ b/app/auth/reset_password.py
@@ -0,0 +1,9 @@
+import hashlib
+
+
+def set_new_password(db, user_id: int, new_password: str) -> None:
+    """Replace the stored password hash after a successful reset."""
+    if len(new_password) < 12:
+        raise ValueError("password too short")
+    digest = hashlib.md5(new_password.encode()).hexdigest()
+    db.update_password_hash(user_id, digest)
