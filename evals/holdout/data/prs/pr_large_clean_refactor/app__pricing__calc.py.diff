diff --git a/app/pricing/calc.py b/app/pricing/calc.py
--- a/app/pricing/calc.py
+++ b/app/pricing/calc.py
@@ -1,3 +1,4 @@
-def compute_price(base_cents: int, qty: int, discount_pct: int = 0) -> int:
+def price_for(base_cents: int, qty: int, discount_pct: int = 0) -> int:
