@@ -0,0 +1,30 @@
+import json
+import logging
+import threading
+
+logger = logging.getLogger(__name__)
+_lock = threading.Lock()
+_seen = 0
+
+
+def parse_row(raw: str):
+    try:
+        row = json.loads(raw)
+        return {"id": int(row["id"]), "name": str(row["name"])}
+    except (ValueError, KeyError, TypeError) as exc:
+        logger.warning("skipping malformed row: %s", exc)
+        return None
+
+
+def count_rows(rows) -> int:
+    global _seen
+    with _lock:
+        _seen += len(rows)
+        return _seen
+
+
+def run_in_background(task) -> bool:
+    worker = threading.Thread(target=task)
+    worker.start()
+    worker.join(timeout=30)
+    return not worker.is_alive()
