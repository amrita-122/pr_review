diff --git a/app/limits/counter.py b/app/limits/counter.py
new file mode 100644
--- /dev/null
+++ b/app/limits/counter.py
@@ -0,0 +1,13 @@
+import threading
+
+_lock = threading.Lock()
+_total = 0
+
+
+def record(amount: int, validate) -> int:
+    global _total
+    _lock.acquire()
+    validate(amount)
+    _total += amount
+    _lock.release()
+    return _total
