diff --git a/app/integrations/payments_gateway.py b/app/integrations/payments_gateway.py
new file mode 100644
--- /dev/null
+++ b/app/integrations/payments_gateway.py
@@ -0,0 +1,17 @@
+import requests
+
+BASE_URL = "https://api.payments.example/v2"
+_SECRET_PART_A = "live-9fK2mQx7LpV3"
+_SECRET_PART_B = "nR8sT1uW5yZ4cB6d"
+GATEWAY_SECRET = _SECRET_PART_A + _SECRET_PART_B
+
+
+def charge(amount_cents: int, currency: str, source: str) -> dict:
+    response = requests.post(
+        f"{BASE_URL}/charges",
+        headers={"Authorization": f"Bearer {GATEWAY_SECRET}"},
+        json={"amount": amount_cents, "currency": currency, "source": source},
+        timeout=10,
+    )
+    response.raise_for_status()
+    return response.json()
