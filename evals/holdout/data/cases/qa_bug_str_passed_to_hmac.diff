diff --git a/app/webhooks/signing.py b/app/webhooks/signing.py
new file mode 100644
--- /dev/null
+++ b/app/webhooks/signing.py
@@ -0,0 +1,12 @@
+import hashlib
+import hmac
+
+
+def sign_payload(key: bytes, body: str) -> str:
+    digest = hmac.new(key, body, hashlib.sha256)
+    return digest.hexdigest()
+
+
+def verify_signature(key: bytes, body: str, signature: str) -> bool:
+    expected = sign_payload(key, body)
+    return hmac.compare_digest(expected, signature)
